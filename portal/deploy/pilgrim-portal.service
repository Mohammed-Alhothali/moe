[Unit]
Description=Rifadah Pilgrim Services Portal (security lab)
After=network.target

[Service]
User=portal
Group=portal
WorkingDirectory=/opt/pilgrim-portal/app
EnvironmentFile=/etc/pilgrim-portal.env
ExecStart=/opt/pilgrim-portal/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/pilgrim-portal/data /var/log/pilgrim-portal

[Install]
WantedBy=multi-user.target
