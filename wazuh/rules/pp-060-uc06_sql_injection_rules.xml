<!--
  UC06 - SQL injection attempts against the pilgrim portal (permit search)
  Sources : nginx access log (edge, URL-encoded)   - decoder: built-in web-accesslog
            pilgrim portal audit log (app, decoded) - decoder: pilgrim-portal (event=permit_search, field q)
  ATT&CK  : T1190 Exploit Public-Facing Application

  Why not just the built-in rule 31103?
    31103 matches a handful of literal strings (select%20, union+ ...). It misses common encodings
    ('%27 OR ...', comment terminators, time-based probes) and, on a 200 response, Wazuh ends in
    31106 "web attack returned 200 (success)" - misleading for a parameterized app that simply
    returned "no results". These rules replace that with:

    110601  edge: injection grammar in the URL (quotes, tautologies, UNION SELECT, comment
            terminators, time-based functions, schema tables, stacked queries), URL-encoded forms included
    110602  edge: 5+ injection attempts from one IP in 60 s -> automated scanner (sqlmap-style)
    110603  application: the same grammar in the DECODED search parameter (no encoding tricks)
    110604  correlation: the injection reached the application from the same IP within 30 s
    110605  5+ injections that reached the application from one IP in 60 s. In real traffic every
            search is seen by the app and then by the edge, so the edge event ends as 110604 and the
            engine never counts it for 110602; this rule is the burst for that path.

  False-positive control
    * Patterns need injection STRUCTURE, not keywords: a pilgrim named "D'Or" or a search for
      "union" alone does not match; ' OR 'x'='x does.
    * Siblings are evaluated highest level first, so these level 8-12 rules are tried before the
      built-in 31103/31108 and keep the verdict accurate.
    * Approved scanners (internal vulnerability scans) go in etc/lists/pp-trusted-ips.
-->

<group name="web,pilgrim_portal,uc06,">

  <rule id="110601" level="8">
    <if_sid>31100</if_sid>
    <url type="pcre2">(?i)(?:union(?:\s|\+|%20|%09|/\*.*?\*/)+(?:all(?:\s|\+|%20)+)?select)|(?:(?:'|%27)(?:\s|\+|%20)*(?:or|and)(?:\s|\+|%20)+(?:'|%27)?\w+(?:'|%27)?(?:\s|\+|%20)*(?:=|%3d|&lt;|%3c|&gt;|%3e|like))|(?:(?:'|%27)(?:\s|\+|%20)*(?:--|%2d%2d|#|%23|/\*|%2f%2a))|(?:(?:sleep|benchmark|pg_sleep)(?:\s|\+|%20)*(?:\(|%28))|(?:information_schema|sqlite_master)|(?:(?:;|%3b)(?:\s|\+|%20)*(?:drop|insert|update|delete|exec)(?:\s|\+|%20))</url>
    <list field="srcip" lookup="not_address_match_key">etc/lists/pp-trusted-ips</list>
    <description>UC06 SQL injection attempt against the portal from $(srcip): $(url)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>pp_sqli,pp_sqli_edge,attack,sql_injection,</group>
  </rule>

  <rule id="110602" level="12" frequency="5" timeframe="60" ignore="300">
    <if_matched_group>pp_sqli_edge</if_matched_group>
    <same_srcip />
    <description>UC06 Automated SQL injection scanning: 5+ injection attempts from $(srcip) in 60 seconds.</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>pp_sqli,attack,sql_injection,</group>
  </rule>

  <rule id="110603" level="10">
    <if_sid>110016</if_sid>
    <field name="q" type="pcre2">(?i)(?:\bunion\s+(?:all\s+)?select\b)|(?:'\s*(?:or|and)\s+'?\w+'?\s*(?:=|&lt;|&gt;|\blike\b))|(?:'\s*(?:--|#|/\*))|(?:\b(?:sleep|benchmark|pg_sleep)\s*\()|(?:\binformation_schema\b|\bsqlite_master\b)|(?:;\s*(?:drop|insert|update|delete|exec)\s)</field>
    <description>UC06 SQL injection attempt in the permit search parameter from $(srcip) (decoded at the application).</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>pp_sqli,pp_sqli_app,attack,sql_injection,</group>
  </rule>

  <rule id="110604" level="11" timeframe="30">
    <if_sid>110601</if_sid>
    <if_matched_sid>110603</if_matched_sid>
    <same_srcip />
    <description>UC06 SQL injection from $(srcip) seen at the edge AND reaching the application search handler.</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>pp_sqli,pp_sqli_edge,attack,sql_injection,</group>
  </rule>

  <rule id="110605" level="12" frequency="5" timeframe="60" ignore="300">
    <if_matched_sid>110604</if_matched_sid>
    <same_srcip />
    <description>UC06 Automated SQL injection reaching the application: 5+ injection searches from $(srcip) in 60 seconds.</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>pp_sqli,attack,sql_injection,</group>
  </rule>

</group>
