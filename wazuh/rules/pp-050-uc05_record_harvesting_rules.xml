<!--
  UC05 - Pilgrim record harvesting (insider data collection) and authorization probing
  Source : pilgrim portal audit log (event=record_view, result=allowed|denied)
  ATT&CK : T1213 Data from Information Repositories; T1190 (probing the access control)

  Logic
    110501  one account opens 12+ DIFFERENT pilgrim records within 3 minutes.
            The access is authorized, which is exactly why it matters: passport numbers and
            phone numbers of pilgrims are prime material for visa fraud and Hajj scams.
            Baseline: a case handler works ~3-5 records per 3 minutes.
    110502  one account is denied access to 5+ records within 2 minutes - someone is walking
            record IDs that do not belong to them (classic IDOR probing).

  False-positive control
    * different_field pilgrim_id: re-opening the same record does not count.
    * Staff doing approved bulk reviews (e.g. visa-processing peaks) go in etc/lists/pp-bulk-reviewers.
-->

<group name="pilgrim_portal,uc05,">

  <rule id="110501" level="10" frequency="12" timeframe="180" ignore="300">
    <if_matched_sid>110014</if_matched_sid>
    <same_field>username</same_field>
    <different_field>pilgrim_id</different_field>
    <list field="username" lookup="not_match_key">etc/lists/pp-bulk-reviewers</list>
    <description>UC05 Record harvesting: $(username) [$(role)] opened 12+ different pilgrim records in 3 minutes.</description>
    <mitre>
      <id>T1213</id>
    </mitre>
    <group>pp_data_harvesting,</group>
  </rule>

  <rule id="110502" level="10" frequency="5" timeframe="120" ignore="300">
    <if_matched_sid>110015</if_matched_sid>
    <same_field>username</same_field>
    <description>UC05 Authorization probing: $(username) [$(role)] was denied 5+ pilgrim records in 2 minutes (IDOR attempt).</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>pp_authz_probing,</group>
  </rule>

</group>
