<!--
  UC01 - Automated booking abuse (permit / slot scalping bots)
  Source : pilgrim portal audit log (event=booking_attempt)
  ATT&CK : T1499.003 Application Exhaustion Flood (closest fit; slot scalping is business-logic abuse)

  Logic
    110101  one account makes 10+ booking attempts within 60 s       (a human manages 1-3 per minute)
    110102  one source IP makes 15+ booking attempts within 60 s,
            each from a different account than the last              (bot farm rotating accounts)

  False-positive control
    * Hajj reality: thousands of pilgrims share hotel / carrier NAT IPs, so the per-IP rule needs
      a higher threshold than the per-account rule, plus an allowlist of known shared IPs
      (campaign offices, load-test agents) in etc/lists/pp-trusted-ips.
    * ignore="120": once a bot is flagged, the rule stays quiet for 2 minutes instead of
      raising an alert for every 10 further attempts.
-->

<group name="pilgrim_portal,uc01,">

  <rule id="110101" level="10" frequency="10" timeframe="60" ignore="120">
    <if_matched_sid>110013</if_matched_sid>
    <same_field>username</same_field>
    <list field="srcip" lookup="not_address_match_key">etc/lists/pp-trusted-ips</list>
    <description>UC01 Booking bot: account $(username) made 10+ booking attempts in 60 seconds from $(srcip).</description>
    <mitre>
      <id>T1499.003</id>
    </mitre>
    <group>pp_bot,</group>
  </rule>

  <rule id="110102" level="12" frequency="15" timeframe="60" ignore="120">
    <if_matched_sid>110013</if_matched_sid>
    <same_srcip />
    <different_field>username</different_field>
    <list field="srcip" lookup="not_address_match_key">etc/lists/pp-trusted-ips</list>
    <description>UC01 Booking bot farm: 15+ booking attempts in 60 seconds from $(srcip) using rotating accounts.</description>
    <mitre>
      <id>T1499.003</id>
    </mitre>
    <group>pp_bot,</group>
  </rule>

</group>
