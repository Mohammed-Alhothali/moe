<!--
  UC02 - Credential stuffing and password guessing against pilgrim / agency accounts
  Source : pilgrim portal audit log (event=login_failed, reason=bad_password|unknown_user)
  ATT&CK : T1110.004 Credential Stuffing, T1110.001 Password Guessing

  Logic
    110201  8+ failed logins from one IP, each for a different account, within 2 min    (stuffing, medium)
    110202  5+ logins for NON-EXISTENT accounts from one IP within 2 min                 (stuffing, high)
    110203  6+ wrong passwords for ONE existing account within 2 min, from any IP        (guessing)

  Why two stuffing rules (false-positive control)
    During the season many pilgrims sit behind one hotel or carrier NAT address, so several
    genuine users mistyping passwords from one IP is normal (110201 stays medium).
    Real people almost never mistype their USERNAME into an account that does not exist,
    while leaked combo lists are full of accounts the portal never had. Counting
    unknown_user failures (110202) separates the attack from the crowd.
    Known shared IPs can also be listed in etc/lists/pp-trusted-ips.

  All three alerts carry group pp_bruteforce, which UC03 correlates with a later success.
-->

<group name="pilgrim_portal,uc02,">

  <rule id="110201" level="8" frequency="8" timeframe="120">
    <if_matched_group>pp_login_failed</if_matched_group>
    <same_srcip />
    <different_field>username</different_field>
    <list field="srcip" lookup="not_address_match_key">etc/lists/pp-trusted-ips</list>
    <description>UC02 Possible credential stuffing: failed logins for 8+ different accounts from $(srcip) in 2 minutes.</description>
    <mitre>
      <id>T1110.004</id>
    </mitre>
    <group>pp_bruteforce,</group>
  </rule>

  <rule id="110202" level="11" frequency="5" timeframe="120">
    <if_matched_group>pp_unknown_user</if_matched_group>
    <same_srcip />
    <different_field>username</different_field>
    <list field="srcip" lookup="not_address_match_key">etc/lists/pp-trusted-ips</list>
    <description>UC02 Credential stuffing: $(srcip) tried 5+ non-existent accounts in 2 minutes (leaked combo list pattern).</description>
    <mitre>
      <id>T1110.004</id>
    </mitre>
    <group>pp_bruteforce,</group>
  </rule>

  <rule id="110203" level="10" frequency="6" timeframe="120">
    <if_matched_group>pp_bad_password</if_matched_group>
    <same_field>username</same_field>
    <description>UC02 Password guessing: 6+ wrong passwords for account $(username) in 2 minutes (latest from $(srcip)).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>pp_bruteforce,pp_password_guessing,</group>
  </rule>

</group>
