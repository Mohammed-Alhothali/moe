<!--
  UC11 - Obfuscated PowerShell and download cradles
  Sources : Sysmon event 1 (command line) and PowerShell event 4104 (script block logging, decoded)
  ATT&CK  : T1059.001 PowerShell, T1027 Obfuscated Files or Information, T1105 Ingress Tool Transfer

  Logic
    111101  PowerShell started with an encoded command (-enc + base64) or a hidden window
    111102  a download cradle on the command line: a web download fed straight into Invoke-Expression
    111103  the same cradle seen in the DECODED script block (4104) - catches it even when the
            command line itself was encoded or obfuscated

  False-positive control
    * Management agents (SCCM CcmExec, Intune) legitimately use -EncodedCommand; they are excluded by
      parent process with negate="yes" instead of being allowlisted globally.
    * The cradle rules need BOTH a download primitive and Invoke-Expression; either alone is common in admin work.
  Engine note (applies to every process-creation rule in this library)
    Wazuh loads level-0 rules as level 99, so its level-0 classifiers under Sysmon event 1 (92025 reg.exe,
    92028 PowerShell running a script file, 92042 netsh, 92069 started by WMI) are tried before any sibling
    and absorb the event. Process rules therefore attach to 61603 AND to those four classifiers.
-->

<group name="windows,sysmon,powershell,pilgrim_endpoint,uc11,">

  <rule id="111101" level="10">
    <if_sid>61603, 92025, 92028, 92042, 92069</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s[-/](e|ec|en|enc|enco|encod|encode|encodedcommand)\s+[A-Za-z0-9+/=]{20,}|\s[-/]w(indowstyle)?\s+h(idden)?\b</field>
    <field name="win.eventdata.parentImage" type="pcre2" negate="yes">(?i)\\(CcmExec|IntuneManagementExtension|AgentExecutor)\.exe$</field>
    <description>UC11 Obfuscated PowerShell on $(win.system.computer): encoded command or hidden window (parent $(win.eventdata.parentImage)).</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
    <group>pp_powershell,pp_execution,</group>
  </rule>

  <rule id="111102" level="12">
    <if_sid>61603, 92025, 92028, 92042, 92069</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^(?=.*\b(iex|invoke-expression)\b)(?=.*(downloadstring|downloaddata|net\.webclient|invoke-webrequest|\biwr\b|invoke-restmethod|\birm\b|start-bitstransfer)).*$</field>
    <description>UC11 PowerShell download cradle on $(win.system.computer): web content executed directly in memory.</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1105</id>
    </mitre>
    <group>pp_powershell,pp_execution,</group>
  </rule>

  <rule id="111103" level="12">
    <if_sid>91802</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)^(?=.*\b(iex|invoke-expression)\b)(?=.*(downloadstring|downloaddata|net\.webclient|invoke-webrequest|\biwr\b|invoke-restmethod|\birm\b|start-bitstransfer)).*$</field>
    <description>UC11 PowerShell download cradle found in a decoded script block on $(win.system.computer) (event 4104).</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1105</id>
    </mitre>
    <group>pp_powershell,pp_execution,</group>
  </rule>

</group>
